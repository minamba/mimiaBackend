@{
    ViewData["Title"] = "Lien invalide";
}

<h1>Ce lien n'est plus valable</h1>
<p class="auth-subtitle">
    Un lien de réinitialisation expire au bout de deux heures et ne fonctionne
    qu'une seule fois. Demandez-en un nouveau.
</p>

<p class="auth-switch">
    <a asp-action="ForgotPassword" asp-controller="Account">Demander un nouveau lien</a>
</p>

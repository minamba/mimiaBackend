@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Nouveau mot de passe";
}

@if (Model.Reussi)
{
    <h1>C'est fait</h1>
    <p class="auth-subtitle">
        Votre mot de passe a été changé. Vous pouvez vous connecter avec le nouveau.
    </p>

    <p class="auth-switch">
        <a asp-action="Login" asp-controller="Account" asp-route-returnUrl="@Model.ReturnUrl">
            Se connecter
        </a>
    </p>
}
else
{
    <h1>Nouveau mot de passe</h1>
    <p class="auth-subtitle">Choisissez un mot de passe d'au moins 10 caractères.</p>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert">
            <ul>
                @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="ResetPassword" asp-controller="Account" method="post">
        @* Le jeton voyage en champ caché : le placer dans l'URL du POST le
           ferait apparaître dans les journaux du serveur. *@
        <input type="hidden" asp-for="Jeton" />
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" type="password" autocomplete="new-password" autofocus data-regles="mdp" />
            <ul class="regles-mdp" id="mdp-regles">
                <li data-regle="longueur">10 caractères au minimum</li>
                <li data-regle="majuscule">une majuscule</li>
                <li data-regle="minuscule">une minuscule</li>
                <li data-regle="chiffre">un chiffre</li>
            </ul>
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword"></label>
            @* Même marqueur qu'à l'inscription : la comparaison se fait avant
               l'envoi, sinon une faute de frappe vide les deux champs. *@
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password"
                   data-confirmation="mdp" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn">Enregistrer</button>
    </form>
}

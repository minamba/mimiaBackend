@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Mot de passe oublié";
}

@if (Model.Envoye)
{
    <h1>Vérifiez votre boîte mail</h1>
    <p class="auth-subtitle">
        Si un compte existe pour <strong>@Model.Email</strong>, un lien de
        réinitialisation vient d'y être envoyé. Il est valable deux heures.
    </p>

    <p class="auth-subtitle" style="margin-top:18px;">
        Rien reçu ? Regardez dans les indésirables. Si votre compte a été créé
        avec Google, il n'a pas de mot de passe : connectez-vous avec le bouton
        Google.
    </p>

    <p class="auth-switch">
        <a asp-action="Login" asp-controller="Account" asp-route-returnUrl="@Model.ReturnUrl">
            Revenir à la connexion
        </a>
    </p>
}
else
{
    <h1>Mot de passe oublié</h1>
    <p class="auth-subtitle">
        Indiquez votre adresse : nous vous envoyons un lien pour en choisir un nouveau.
    </p>

    <form asp-action="ForgotPassword" asp-controller="Account" method="post">
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <button type="submit" class="btn">Envoyer le lien</button>
    </form>

    <p class="auth-switch">
        <a asp-action="Login" asp-controller="Account" asp-route-returnUrl="@Model.ReturnUrl">
            Revenir à la connexion
        </a>
    </p>
}
